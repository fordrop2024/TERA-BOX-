# ==============================================================
# TeraBox Search Bot - Configuration Environment Variables
# ==============================================================
# Rename this file to .env and fill in your actual values before running the bot.
# NEVER commit your actual .env file with sensitive tokens to Git.

# --------------------------------------------------------------
# 1. TELEGRAM BOT CONFIGURATION (Required)
# --------------------------------------------------------------
# Obtain your bot token by messaging @BotFather on Telegram:
# Send /newbot -> Choose a name -> Choose a username ending in 'bot'.
# Example format: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ123456789
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# --------------------------------------------------------------
# 2. ADMINISTRATOR SECURITY (Required)
# --------------------------------------------------------------
# Only this Telegram numerical User ID can run admin commands:
# (/status, /accounts, /addaccount, /delaccount, /toggleaccount, /sync).
# Regular users will only have access to /start, /help, and search queries.
# Find your Telegram User ID by sending any message to @userinfobot on Telegram.
# Example: 123456789
ADMIN_TELEGRAM_ID="123456789"

# --------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# --------------------------------------------------------------
# Local path to the SQLite database file storing indexed file metadata.
# The bot will automatically create the database and tables if missing.
DB_PATH="data/terabox_search.db"

# Automatically seed realistic sample files (movies, software, courses, books)
# if the database is newly initialized, so search works out-of-the-box:
ENABLE_SAMPLE_DATA="true"

# --------------------------------------------------------------
# 4. BOT SEARCH SETTINGS
# --------------------------------------------------------------
# Number of search results to display per page (1 to 10 recommended):
DEFAULT_PAGE_SIZE="5"

# Request timeout in seconds for external TeraBox API calls:
TERABOX_REQUEST_TIMEOUT="15"

# --------------------------------------------------------------
# 5. OPTIONAL DEFAULT TERABOX ACCOUNT CREDENTIALS
# --------------------------------------------------------------
# You can also add accounts at runtime using the Telegram command:
# /addaccount <label> <ndus_cookie>
#
# How to get your TeraBox NDUS cookie:
# 1. Log in to your TeraBox account at https://www.terabox.com
# 2. Press F12 to open Browser Developer Tools -> Go to 'Application' or 'Storage' tab.
# 3. Under 'Cookies' -> https://www.terabox.com -> Find the cookie named 'ndus'.
# 4. Copy its value here:
TERABOX_ACCOUNT_1_LABEL="Primary-Cloud"
TERABOX_ACCOUNT_1_NDUS=""
